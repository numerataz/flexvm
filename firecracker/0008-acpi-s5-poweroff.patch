new file mode 100644
index 000000000..cd5967cff
--- /dev/null
+++ b/src/vmm/src/devices/legacy/acpi_power.rs
@@ -0,0 +1,99 @@
+// Copyright 2026 FlexVM contributors.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Hardware-reduced ACPI S5 (soft off). No suspend states or wake sources.
+use std::sync::{Arc, Barrier};
+
+use vmm_sys_util::eventfd::EventFd;
+
+use crate::logger::error;
+use crate::vstate::bus::BusDevice;
+
+/// Adjacent byte-wide Sleep Control and Sleep Status I/O registers.
+pub const ACPI_SLEEP_CONTROL: u64 = 0x600;
+pub const ACPI_SLEEP_STATUS: u64 = ACPI_SLEEP_CONTROL + 1;
+const SLP_EN: u8 = 1 << 5;
+const SLP_TYP: u8 = 7 << 2;
+
+/// The sole advertised sleep type is zero, meaning S5.
+#[derive(Debug)]
+pub struct AcpiPowerDevice {
+    exit_evt: EventFd,
+    requested: bool,
+}
+
+impl AcpiPowerDevice {
+    /// Use the same VMM termination event as the legacy reset device.
+    pub fn new(exit_evt: EventFd) -> Self {
+        Self {
+            exit_evt,
+            requested: false,
+        }
+    }
+
+    /// A pending power-off cannot be captured as a resumable checkpoint.
+    pub fn requested(&self) -> bool {
+        self.requested
+    }
+}
+
+impl BusDevice for AcpiPowerDevice {
+    fn read(&mut self, _base: u64, _offset: u64, data: &mut [u8]) {
+        // SLP_EN is write-only. S5 has type zero and cannot wake (WAK_STS=0).
+        data.fill(0);
+    }
+
+    fn write(&mut self, _base: u64, offset: u64, data: &[u8]) -> Option<Arc<Barrier>> {
+        if offset == 0 && data.len() == 1 && data[0] & (SLP_EN | SLP_TYP) == SLP_EN {
+            self.requested = true;
+            if let Err(err) = self.exit_evt.write(1) {
+                error!("Failed to trigger ACPI S5 power-off: {err}");
+            }
+        }
+        // Status writes have no effect: there are no wake events to clear.
+        None
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn rejects_other_sleep_states_and_invalid_accesses() {
+        let evt = EventFd::new(libc::EFD_NONBLOCK).unwrap();
+        let mut dev = AcpiPowerDevice::new(evt.try_clone().unwrap());
+        for offset in [0, 1, 2] {
+            for value in 0..=u8::MAX {
+                if offset == 0 && value & (SLP_EN | SLP_TYP) == SLP_EN {
+                    continue;
+                }
+                dev.write(ACPI_SLEEP_CONTROL, offset, &[value]);
+            }
+        }
+        dev.write(ACPI_SLEEP_CONTROL, 0, &[]);
+        dev.write(ACPI_SLEEP_CONTROL, 0, &[SLP_EN, 0]);
+        assert!(!dev.requested());
+        assert_eq!(
+            evt.read().unwrap_err().kind(),
+            std::io::ErrorKind::WouldBlock
+        );
+        let mut bytes = [0xff; 2];
+        dev.read(ACPI_SLEEP_CONTROL, 0, &mut bytes);
+        assert_eq!(bytes, [0, 0]);
+    }
+
+    #[test]
+    fn s5_notifies_vmm_and_latches_pending_shutdown() {
+        let evt = EventFd::new(libc::EFD_NONBLOCK).unwrap();
+        let mut dev = AcpiPowerDevice::new(evt.try_clone().unwrap());
+        dev.write(ACPI_SLEEP_CONTROL, 0, &[SLP_EN]);
+        assert!(dev.requested());
+        assert_eq!(evt.read().unwrap(), 1);
+        dev.write(ACPI_SLEEP_CONTROL, 1, &[0x80]);
+        assert!(dev.requested());
+        let mut value = [0xff];
+        dev.read(ACPI_SLEEP_CONTROL, 0, &mut value);
+        assert_eq!(value, [0]);
+    }
+}
