+/// Caller bindings and a locally trusted reference must agree before any backing file opens.
+fn check_confined_blocks(
+    reference: &MicrovmState,
+    state: &MicrovmState,
+    bindings: &[crate::vmm_config::snapshot::ConfinedBlock],
+) -> Result<(), RestoreFromSnapshotError> {
+    use crate::devices::virtio::block::persist::BlockState;
+    let refuse = |why: &str| RestoreFromSnapshotError::Devices(why.into());
+    let (VirtioDevicesState::Mmio(want), VirtioDevicesState::Mmio(have)) = (
+        &reference.device_states.virtio_state,
+        &state.device_states.virtio_state,
+    ) else {
+        return Err(refuse("confined blocks require MMIO transport"));
+    };
+    if bindings.len() != want.block_devices.len() || bindings.len() != have.block_devices.len() {
+        return Err(refuse("confined block slots differ in number"));
+    }
+    let (mut ids, mut paths, mut serials) = (
+        std::collections::BTreeSet::new(),
+        std::collections::BTreeSet::new(),
+        std::collections::BTreeSet::new(),
+    );
+    for ((binding, reference), state) in bindings
+        .iter()
+        .zip(&want.block_devices)
+        .zip(&have.block_devices)
+    {
+        if !binding.validate()
+            || !ids.insert(&binding.drive_id)
+            || !paths.insert(&binding.path_on_host)
+            || !serials.insert(&binding.serial)
+        {
+            return Err(refuse("invalid or duplicate confined block binding"));
+        }
+        if reference.device_id != binding.drive_id || state.device_id != binding.drive_id {
+            return Err(refuse("confined block slots differ in identity or order"));
+        }
+        let (BlockState::Virtio(reference), BlockState::Virtio(state)) =
+            (&reference.device_state, &state.device_state)
+        else {
+            return Err(refuse(
+                "vhost-user blocks cannot be restored with file bindings",
+            ));
+        };
+        if !state.check_confined(reference, binding) {
+            return Err(refuse(
+                "confined block identity, path, geometry or policy differs",
+            ));
+        }
+    }
+    Ok(())
+}
