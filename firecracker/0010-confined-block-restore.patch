+/// A caller-selected raw block slot. Snapshot data never selects its backing file.
+#[derive(Clone, Debug, PartialEq, Eq, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct ConfinedBlock {
+    /// Stable slot identifier, matching both trusted reference and saved device.
+    pub drive_id: String,
+    /// Explicit guest-visible serial (1–20 ASCII bytes).
+    pub serial: String,
+    /// Caller-owned single-component alias, disk-N, in the VMM working directory.
+    pub path_on_host: PathBuf,
+    /// Fixed sector-aligned logical capacity of the selected raw regular file.
+    pub capacity_bytes: u64,
+    /// Whether the backing file may be opened for writes.
+    pub is_read_only: bool,
+    /// Whether this slot is the boot root device.
+    pub is_root_device: bool,
+}
+
+impl ConfinedBlock {
+    pub(crate) fn validate(&self) -> bool {
+        let Some(path) = self.path_on_host.to_str() else {
+            return false;
+        };
+        let alias = path.strip_prefix("disk-").is_some_and(|slot| {
+            !slot.is_empty() && slot.len() <= 20 && slot.bytes().all(|b| b.is_ascii_digit())
+        });
+        alias
+            && !self.drive_id.is_empty()
+            && self.drive_id.len() <= 64
+            && self
+                .drive_id
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b"._-".contains(&b))
+            && !self.serial.is_empty()
+            && self.serial.len() <= 20
+            && self
+                .serial
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b"._-".contains(&b))
+            && self.capacity_bytes > 0
+            && self.capacity_bytes <= (8 << 40)
+            && self.capacity_bytes.is_multiple_of(512)
+    }
+}
