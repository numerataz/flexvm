+static bool flexvm_xapic_readable(unsigned index)
+{
+    return index == 0x2 || index == 0x3 || (index >= 8 && index <= 0xb) ||
+           (index >= 0xd && index <= 0x28) ||
+           (index >= 0x30 && index <= 0x39) || index == 0x3e;
+}
+
+void apic_flexvm_read_xapic(APICCommonState *s,
+                           uint8_t record[FLEXVM_XAPIC_IMAGE_SIZE])
+{
+    memset(record, 0, FLEXVM_XAPIC_IMAGE_SIZE);
+    for (unsigned int i = 0; i < FLEXVM_XAPIC_IMAGE_SIZE / 16; i++) {
+        if (flexvm_xapic_readable(i)) {
+            uint64_t value;
+
+            apic_register_read(s, i, &value);
+            stl_le_p(record + i * 16, value);
+        }
+    }
+}
+
+void apic_flexvm_write_xapic(APICCommonState *s,
+                            const uint8_t record[FLEXVM_XAPIC_IMAGE_SIZE])
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    uint32_t current;
+    unsigned int divide;
+
+    s->id = ldl_le_p(record + 0x020) >> 24;
+    s->tpr = ldl_le_p(record + 0x080) & 0xff;
+    s->log_dest = ldl_le_p(record + 0x0d0) >> 24;
+    s->dest_mode = ldl_le_p(record + 0x0e0) >> 28;
+    s->spurious_vec = ldl_le_p(record + 0x0f0) & 0x1ff;
+    for (unsigned int i = 0; i < 8; i++) {
+        s->isr[i] = ldl_le_p(record + 0x100 + i * 16);
+        s->tmr[i] = ldl_le_p(record + 0x180 + i * 16);
+        s->irr[i] = ldl_le_p(record + 0x200 + i * 16);
+    }
+    s->esr = ldl_le_p(record + 0x280);
+    /* Restoring ICR contents must not send an interrupt. */
+    s->icr[0] = ldl_le_p(record + 0x300);
+    s->icr[1] = ldl_le_p(record + 0x310);
+    for (unsigned int i = 0; i < APIC_LVT_NB; i++) {
+        s->lvt[i] = ldl_le_p(record + 0x320 + i * 16);
+    }
+    s->initial_count = ldl_le_p(record + 0x380);
+    current = MIN(s->initial_count, ldl_le_p(record + 0x390));
+    s->divide_conf = ldl_le_p(record + 0x3e0) & 0xb;
+    divide = (s->divide_conf & 3) | ((s->divide_conf >> 1) & 4);
+    s->count_shift = (divide + 1) & 7;
+    s->initial_count_load_time = now -
+        ((int64_t)(s->initial_count - current) << s->count_shift);
+    apic_timer_update(s, now);
+    apic_sync_vapic(s, SYNC_TO_VAPIC);
+    apic_check_pic(s);
+    apic_update_irq(s);
+}
