+static CPUState *flexvm_stopped_xapic(uint16_t index, Error **errp)
+{
+    CPUX86State *env = flexvm_stopped_cpu(index, errp);
+    X86CPU *cpu;
+    APICCommonState *apic;
+
+    if (!env) {
+        return NULL;
+    }
+    cpu = env_archcpu(env);
+    apic = cpu->apic_state;
+    if (!apic || is_x2apic_mode(apic)) {
+        error_setg(errp, "FlexVM requires an xAPIC controller");
+        return NULL;
+    }
+    return CPU(cpu);
+}
+
+static void flexvm_read_xapic(CPUState *cpu, run_on_cpu_data data)
+{
+    apic_flexvm_read_xapic(X86_CPU(cpu)->apic_state, data.host_ptr);
+}
+
+static void flexvm_write_xapic(CPUState *cpu, run_on_cpu_data data)
+{
+    apic_flexvm_write_xapic(X86_CPU(cpu)->apic_state, data.host_ptr);
+}
+
+FlexvmX86LapicRecord *qmp_x_flexvm_query_x86_lapic(uint16_t cpu_index,
+                                                Error **errp)
+{
+    static const char hex[] = "0123456789abcdef";
+    CPUState *cpu = flexvm_stopped_xapic(cpu_index, errp);
+    uint8_t bytes[FLEXVM_XAPIC_IMAGE_SIZE];
+    FlexvmX86LapicRecord *result;
+
+    if (!cpu) {
+        return NULL;
+    }
+    run_on_cpu(cpu, flexvm_read_xapic, RUN_ON_CPU_HOST_PTR(bytes));
+    result = g_new0(FlexvmX86LapicRecord, 1);
+    result->record = g_malloc(2 * sizeof(bytes) + 1);
+    for (size_t i = 0; i < sizeof(bytes); i++) {
+        result->record[2 * i] = hex[bytes[i] >> 4];
+        result->record[2 * i + 1] = hex[bytes[i] & 15];
+    }
+    result->record[2 * sizeof(bytes)] = '\0';
+    return result;
+}
+
+void qmp_x_flexvm_set_x86_lapic(uint16_t cpu_index, const char *record,
+                               Error **errp)
+{
+    CPUState *cpu = flexvm_stopped_xapic(cpu_index, errp);
+    uint8_t bytes[FLEXVM_XAPIC_IMAGE_SIZE];
+
+    if (!cpu) {
+        return;
+    }
+    if (strlen(record) != 2 * sizeof(bytes)) {
+        error_setg(errp, "Invalid FlexVM LAPIC image size");
+        return;
+    }
+    for (size_t i = 0; i < sizeof(bytes); i++) {
+        int hi = g_ascii_xdigit_value(record[2 * i]);
+        int lo = g_ascii_xdigit_value(record[2 * i + 1]);
+
+        if (hi < 0 || lo < 0) {
+            error_setg(errp, "Invalid hex in FlexVM LAPIC image");
+            return;
+        }
+        bytes[i] = (hi << 4) | lo;
+    }
+    run_on_cpu(cpu, flexvm_write_xapic, RUN_ON_CPU_HOST_PTR(bytes));
+}
