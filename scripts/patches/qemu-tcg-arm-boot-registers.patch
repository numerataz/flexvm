+void qmp_x_flexvm_set_arm_boot_registers(uint32_t cpu_index, uint64_t pc,
+                                       uint64_t x0, uint32_t pstate,
+                                       Error **errp)
+{
+    Object *machine = OBJECT(qdev_get_machine());
+    CPUState *cs = qemu_get_cpu(cpu_index);
+    CPUARMState *env;
+
+    if (!tcg_enabled() || !object_dynamic_cast(machine, TYPE_VIRT_MACHINE) ||
+        !runstate_check(RUN_STATE_PRELAUNCH) || cpu_index >= 2 ||
+        !cs || !arm_feature(&ARM_CPU(cs)->env, ARM_FEATURE_AARCH64)) {
+        error_setg(errp, "FlexVM ARM boot registers require a prelaunch TCG vCPU");
+        return;
+    }
+
+    env = &ARM_CPU(cs)->env;
+    if (!is_a64(env) || arm_current_el(env) != 1 || pc % 4 ||
+        (pstate & ~(PSTATE_D | PSTATE_A | PSTATE_I | PSTATE_F)) !=
+        PSTATE_MODE_EL1h) {
+        error_setg(errp, "invalid FlexVM ARM EL1 boot registers");
+        return;
+    }
+    env->xregs[0] = x0;
+    env->pc = pc;
+    pstate_write(env, pstate);
+    arm_rebuild_hflags(env);
+}
