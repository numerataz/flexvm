+ArmFlexvmMpState *qmp_x_flexvm_arm_mp_state(uint32_t cpu_index,
+                                           bool has_runnable, bool runnable,
+                                           Error **errp)
+{
+    Object *machine = OBJECT(qdev_get_machine());
+    CPUState *cs = qemu_get_cpu(cpu_index);
+    ARMCPU *cpu;
+    ArmFlexvmMpState *ret;
+
+    if (!tcg_enabled() || !object_dynamic_cast(machine, TYPE_VIRT_MACHINE) ||
+        cpu_index >= 2 || !cs ||
+        (!runstate_check(RUN_STATE_PRELAUNCH) && !cs->stopped)) {
+        error_setg(errp, "FlexVM ARM MP state requires a stopped TCG vCPU");
+        return NULL;
+    }
+    cpu = ARM_CPU(cs);
+    if (cpu->power_state == PSCI_ON_PENDING) {
+        error_setg(errp, "FlexVM ARM vCPU is powering on");
+        return NULL;
+    }
+    if (has_runnable && runnable != (cpu->power_state == PSCI_ON)) {
+        /* Keep architected state intact across the KVM power-state ioctl. */
+        cs->halted = !runnable;
+        cpu->power_state = runnable ? PSCI_ON : PSCI_OFF;
+    }
+    ret = g_new(ArmFlexvmMpState, 1);
+    ret->runnable = cpu->power_state == PSCI_ON;
+    return ret;
+}
