+/*
+ * Called only under the run-control fence and BQL, after the vCPUs and
+ * their pending I/O have stopped. Preserve their nanosecond TSC and
+ * monotonic clock across the hold, including on another host.
+ */
+void x86_flexvm_freeze_clock(bool frozen)
+{
+    CPUState *cpu;
+    uint64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    uint64_t adjustment = 0;
+
+    assert(bql_locked());
+    if (clock_frozen == frozen) {
+        return;
+    }
+    if (frozen) {
+        clock_frozen_at = now;
+    } else {
+        adjustment = clock_frozen_at - now;
+    }
+    clock_frozen = frozen;
+    if (!clock_enabled) {
+        return;
+    }
+
+    clock_offset += adjustment;
+    CPU_FOREACH(cpu) {
+        X86CPU *x86 = X86_CPU(cpu);
+
+        if (!frozen) {
+            x86->env.tsc_offset += adjustment;
+            publish_system_time(&x86->env);
+        }
+        apic_flexvm_reschedule_deadline(x86->apic_state);
+    }
+    if (!frozen && wall_clock_set && first_cpu) {
+        publish_wall_clock(&X86_CPU(first_cpu)->env);
     }
