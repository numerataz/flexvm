     VMChangeStateEntry *run_state;
 } DebugconState;
 
+static DebugconState *checkpoint_lane;
+
+static bool debugcon_lane_idle(const DebugconState *s)
+{
+    return !s->run_active && !s->read_width && !s->pio_waiters &&
+           !s->completion_ack_pending && !s->parallel_ack_pending &&
+           !s->cancel_pending && !s->output_length && !s->run_failed;
+}
+
+static bool debugcon_fence_checkpoint(DebugconState *s, Error **errp)
+{
+    error_setg(&s->checkpoint_blocker, "FlexVM worker run control is unfenced");
+    return migrate_add_blocker(&s->checkpoint_blocker, errp) == 0;
+}
+
+static bool debugcon_register_checkpoint(DebugconState *s, Error **errp)
+{
+    if (!s->checkpoint_control) {
+        return true;
+    }
+    if (checkpoint_lane || !s->run_control) {
+        error_setg(errp, "FlexVM checkpoint requires one run-control device");
+        return false;
+    }
+    if (!debugcon_fence_checkpoint(s, errp)) {
+        return false;
+    }
+    checkpoint_lane = s;
+    return true;
+}
+
+static void debugcon_unregister_checkpoint(DebugconState *s)
+{
+    if (s == checkpoint_lane) {
+        if (s->checkpoint_blocker) {
+            migrate_del_blocker(&s->checkpoint_blocker);
+        }
+        checkpoint_lane = NULL;
+    }
+}
+
+void qmp_x_flexvm_freeze_run_control(bool frozen, Error **errp)
+{
+    DebugconState *s = checkpoint_lane;
+
+    if (!s) {
+        error_setg(errp, "FlexVM checkpoint run control is unavailable");
+        return;
+    }
+    if (s->checkpoint_frozen == frozen) {
+        return;
+    }
+    if (frozen) {
+        if (!debugcon_lane_idle(s) ||
+            (s->other_lane && !debugcon_lane_idle(s->other_lane))) {
+            error_setg(errp, "FlexVM worker still has pending execution or I/O");
+            return;
+        }
+        migrate_del_blocker(&s->checkpoint_blocker);
+    } else if (!debugcon_fence_checkpoint(s, errp)) {
+        return;
+    }
+    s->checkpoint_frozen = frozen;
+}
