+        return NULL;
+    }
+    x86_flexvm_enable_clock();
+    if (has_clock) {
+        x86_flexvm_update_clock(clock, realtime, has_realtime);
+    }
+    result = g_new(FlexvmX86Clock, 1);
+    result->clock = x86_flexvm_get_clock();
+    result->realtime = qemu_clock_get_ns(QEMU_CLOCK_HOST);
+    return result;
+#else
+    error_setg(errp, "FlexVM clock requires a TCG worker");
+    return NULL;
+#endif
+}
