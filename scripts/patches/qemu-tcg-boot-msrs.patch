+static bool flexvm_access_boot_msr(CPUX86State *env, uint32_t index,
+                                   bool set, uint64_t *value)
+{
+#define ACCESS_MSR(index, field) \
+    case index: \
+        if (set) { \
+            env->field = *value; \
+        } else { \
+            *value = env->field; \
+        } \
+        return true
+    switch (index) {
+    ACCESS_MSR(MSR_IA32_SYSENTER_CS, sysenter_cs);
+    ACCESS_MSR(MSR_IA32_SYSENTER_ESP, sysenter_esp);
+    ACCESS_MSR(MSR_IA32_SYSENTER_EIP, sysenter_eip);
+    ACCESS_MSR(MSR_STAR, star);
+#ifdef TARGET_X86_64
+    ACCESS_MSR(MSR_CSTAR, cstar);
+    ACCESS_MSR(MSR_KERNELGSBASE, kernelgsbase);
+    ACCESS_MSR(MSR_FMASK, fmask);
+    ACCESS_MSR(MSR_LSTAR, lstar);
+#endif
+    ACCESS_MSR(MSR_IA32_MISC_ENABLE, msr_ia32_misc_enable);
+    ACCESS_MSR(MSR_MTRRdefType, mtrr_deftype);
+    case MSR_IA32_TSC:
+        if (set) {
+            env->tsc_offset = *value - cpu_get_tsc(env);
+        } else {
+            *value = cpu_get_tsc(env) + env->tsc_offset;
+        }
+        return true;
+    default:
+        return false;
+    }
+#undef ACCESS_MSR
+}
+
+FlexvmX86MsrResult *qmp_x_flexvm_access_x86_msrs(uint16_t cpu_index,
+                                                 bool write,
+                                                 FlexvmX86MsrList *entries,
+                                                 Error **errp)
+{
+    CPUX86State *env = flexvm_stopped_cpu(cpu_index, errp);
+    FlexvmX86MsrResult *result;
+    FlexvmX86MsrList **tail;
+    unsigned int count = 0;
+
+    if (!env) {
+        return NULL;
+    }
+    result = g_new0(FlexvmX86MsrResult, 1);
+    tail = &result->entries;
+    for (; entries && count < 64; entries = entries->next, count++) {
+        FlexvmX86Msr *entry = entries->value;
+        uint64_t value = entry->value;
+        FlexvmX86Msr *actual;
+
+        if (!flexvm_access_boot_msr(env, entry->index, write, &value)) {
+            break;
+        }
+        actual = g_new0(FlexvmX86Msr, 1);
+        actual->index = entry->index;
+        actual->value = value;
+        QAPI_LIST_APPEND(tail, actual);
+    }
+    return result;
+}
