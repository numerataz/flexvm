+static MemTxResult debugcon_mmio_read(void *opaque, hwaddr address,
+                                      uint64_t *value, unsigned width,
+                                      MemTxAttrs attrs)
+{
+    DebugconState *s = opaque;
+    uint8_t reply[DEBUGCON_EXIT_MAX] = {'Q', width};
+
+    stq_le_p(reply + 2, s->mmio_base + address);
+    return debugcon_complete_read(s, reply, sizeof(reply), value, width);
+}
+
+static bool debugcon_wait_for_pio_run(DebugconState *s)
+{
+    CPUState *cpu = current_cpu;
+
+    if (!s->output_length) {
+        return !s->run_failed;
+    }
+
+    /*
+     * TCG may execute another iteration of REP OUTS in the same translation
+     * block. Stop at that access until userspace acknowledges the prior exit.
+     */
+    s->pio_waiters++;
+    cpu_pause(cpu);
+    while (!s->run_failed &&
+           (s->output_length || !s->run_active || s->run_cpu != cpu)) {
+        qemu_cond_wait_bql(&s->read_completed);
+    }
+    s->pio_waiters--;
+    qemu_cond_broadcast(&s->read_completed);
+    return !s->run_failed;
+}
+
+static MemTxResult debugcon_pio_read(void *opaque, hwaddr address,
+                                     uint64_t *value, unsigned width,
+                                     MemTxAttrs attrs)
+{
+    DebugconPioRange *range = opaque;
+    uint8_t reply[8] = {'V', width};
+
+    if (!debugcon_wait_for_pio_run(range->debugcon)) {
+        return MEMTX_ERROR;
+    }
+    stw_le_p(reply + 2, range->first + address);
+    stl_le_p(reply + 4, 1);
+    return debugcon_complete_read(range->debugcon, reply, sizeof(reply),
+                                  value, width);
+}
+
+static void debugcon_pio_write(void *opaque, hwaddr address, uint64_t value,
+                                unsigned width)
+{
+    DebugconPioRange *range = opaque;
+    uint8_t reply[12] = {'U', width};
+
+    if (!debugcon_wait_for_pio_run(range->debugcon)) {
+        return;
+    }
+    stw_le_p(reply + 2, range->first + address);
+    stl_le_p(reply + 4, 1);
+    stl_le_p(reply + 8, value);
+    debugcon_stop_at_exit(range->debugcon, reply, 8 + width);
+}
+
+static const MemoryRegionOps debugcon_pio_ops = {
+    .read_with_attrs = debugcon_pio_read,
+    .write = debugcon_pio_write,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 4,
+    .valid.unaligned = true,
+    .impl.min_access_size = 1,
+    .impl.max_access_size = 4,
+    .impl.unaligned = true,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
+
+static void debugcon_map_pio_range(ISADevice *dev, DebugconState *s,
+                                   unsigned int first, unsigned int end)
+{
+    DebugconPioRange *range;
+
+    assert(s->pio_count < ARRAY_SIZE(s->pio));
+    range = &s->pio[s->pio_count++];
+    range->debugcon = s;
+    range->first = first;
+    memory_region_init_io(&range->region, OBJECT(dev), &debugcon_pio_ops,
+                          range, "flexvm-pio", end - first);
+    memory_region_add_subregion_overlap(isa_address_space_io(dev), first,
+                                        &range->region, 10);
+}
+
+static void debugcon_map_pio(ISADevice *dev, DebugconState *s)
+{
+    const struct {
+        unsigned int first;
+        unsigned int end;
+        bool keep;
+    } reserved[] = {
+        { 0x20, 0x22, s->keep_pic_ports },
+        { 0x40, 0x44, s->keep_pit_ports },
+        { 0x61, 0x62, s->keep_pit_ports },
+        { 0xa0, 0xa2, s->keep_pic_ports },
+        { 0x4d0, 0x4d2, s->keep_pic_ports },
+    };
+    unsigned int first = 0;
+
+    for (size_t i = 0; i < ARRAY_SIZE(reserved); i++) {
+        if (reserved[i].keep) {
+            debugcon_map_pio_range(dev, s, first, reserved[i].first);
+            first = reserved[i].end;
+        }
+    }
+    debugcon_map_pio_range(dev, s, first, 0x10000);
+}
