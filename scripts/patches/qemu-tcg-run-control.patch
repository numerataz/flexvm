 #include "qemu/module.h"
@@ -46,2 +47,8 @@
     bool stop_on_write;
+    bool run_control;
+    bool run_active;
+    bool run_failed;
+    bool output_pending;
+    uint8_t output;
+    VMChangeStateEntry *run_state;
 } DebugconState;
@@ -55,2 +62,58 @@

+static int debugcon_can_run(void *opaque)
+{
+    return 1;
+}
+
+static void debugcon_run_failed(DebugconState *s)
+{
+    if (!s->run_failed) {
+        s->run_failed = true;
+        if (s->run_active && runstate_is_running()) {
+            vm_stop(RUN_STATE_PAUSED);
+        }
+    }
+}
+
+static void debugcon_run(void *opaque, const uint8_t *buf, int len)
+{
+    DebugconState *s = opaque;
+
+    if (s->run_failed || s->run_active || len != 1 || buf[0] != 'R' ||
+        (!runstate_check(RUN_STATE_PRELAUNCH) &&
+         !runstate_check(RUN_STATE_PAUSED))) {
+        debugcon_run_failed(s);
+        return;
+    }
+
+    s->run_active = true;
+    vm_start();
+}
+
+static void debugcon_run_event(void *opaque, QEMUChrEvent event)
+{
+    DebugconState *s = opaque;
+
+    if (event == CHR_EVENT_CLOSED) {
+        debugcon_run_failed(s);
+    }
+}
+
+static void debugcon_run_state(void *opaque, bool running, RunState state)
+{
+    DebugconState *s = opaque;
+
+    if (running || !s->run_active) {
+        return;
+    }
+
+    s->run_active = false;
+    if (!s->run_failed && s->output_pending && state == RUN_STATE_PAUSED &&
+        qemu_chr_fe_write(&s->chr, &s->output, 1) != 1) {
+        error_report("debugcon run control could not deliver port output");
+        s->run_failed = true;
+    }
+    s->output_pending = false;
+}
+
 static void debugcon_ioport_write(void *opaque, hwaddr addr, uint64_t val,
@@ -65,2 +128,13 @@

