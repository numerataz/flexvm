+static bool flexvm_disjoint(hwaddr a, hwaddr a_size,
+                             hwaddr b, hwaddr b_size)
+{
+    return a + a_size <= b || b + b_size <= a;
+}
+
+static bool flexvm_gic_address(hwaddr address, hwaddr size)
+{
+    /* The nested VMM owns this portion of the low PCI aperture. */
+    return address >= base_memmap[VIRT_PCIE_MMIO].base &&
+           address < base_memmap[VIRT_MEM].base &&
+           size <= base_memmap[VIRT_MEM].base - address &&
+           !(address & (64 * KiB - 1));
+}
+
+void qmp_x_flexvm_map_arm_gic(uint64_t distributor, uint64_t redistributor,
+                             uint64_t its, Error **errp)
+{
+    Object *machine = OBJECT(qdev_get_machine());
+    VirtMachineState *vms;
+    SysBusDevice *gic;
+    SysBusDevice *its_bus;
+    hwaddr distributor_size, redistributor_size, its_size;
+
+    if (!tcg_enabled() || !object_dynamic_cast(machine, TYPE_VIRT_MACHINE) ||
+        !runstate_check(RUN_STATE_PRELAUNCH)) {
+        error_setg(errp, "FlexVM GIC mapping requires a prelaunch TCG virt machine");
+        return;
+    }
+    vms = VIRT_MACHINE(machine);
+    if (vms->gic_version != VIRT_GIC_VERSION_3 || !vms->its_device ||
+        MACHINE(vms)->smp.cpus > 2 || vms->flexvm_gic_mapped) {
+        error_setg(errp, "FlexVM GIC mapping requires an unmapped GICv3 and ITS");
+        return;
+    }
+
+    gic = SYS_BUS_DEVICE(vms->gic);
+    its_bus = SYS_BUS_DEVICE(vms->its_device);
+    distributor_size = memory_region_size(sysbus_mmio_get_region(gic, 0));
+    redistributor_size = memory_region_size(sysbus_mmio_get_region(gic, 1));
+    its_size = memory_region_size(sysbus_mmio_get_region(its_bus, 0));
+    if (!flexvm_gic_address(distributor, distributor_size) ||
+        !flexvm_gic_address(redistributor, redistributor_size) ||
+        !flexvm_gic_address(its, its_size) ||
+        !flexvm_disjoint(distributor, distributor_size,
+                         redistributor, redistributor_size) ||
+        !flexvm_disjoint(distributor, distributor_size, its, its_size) ||
+        !flexvm_disjoint(redistributor, redistributor_size, its, its_size)) {
+        error_setg(errp, "invalid FlexVM GIC mapping");
+        return;
+    }
+
+    memory_region_transaction_begin();
+    sysbus_mmio_map_overlap(gic, 0, distributor, 1);
+    sysbus_mmio_map_overlap(gic, 1, redistributor, 1);
+    sysbus_mmio_map_overlap(its_bus, 0, its, 1);
+    memory_region_transaction_commit();
+    vms->flexvm_gic_mapped = true;
+}
+
+void qmp_x_flexvm_pulse_arm_gsi(uint32_t gsi, Error **errp)
+{
+    Object *machine = OBJECT(qdev_get_machine());
+
+    if (!tcg_enabled() || !object_dynamic_cast(machine, TYPE_VIRT_MACHINE) ||
+        !VIRT_MACHINE(machine)->flexvm_gic_mapped || gsi >= NUM_IRQS) {
+        error_setg(errp, "invalid FlexVM ARM GSI");
+        return;
+    }
+    qemu_irq_pulse(qdev_get_gpio_in(VIRT_MACHINE(machine)->gic, gsi));
+}
