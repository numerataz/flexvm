+
+static void debugcon_mmio_write(void *opaque, hwaddr address, uint64_t value,
+                                 unsigned width)
+{
+    DebugconState *s = opaque;
+    uint8_t reply[DEBUGCON_EXIT_MAX] = {'M', width};
+
+    stq_le_p(reply + 2, s->mmio_base + address);
+    stq_le_p(reply + 10, value);
+    debugcon_stop_at_exit(s, reply, sizeof(reply));
+}
+
+static const MemoryRegionOps debugcon_mmio_ops = {
