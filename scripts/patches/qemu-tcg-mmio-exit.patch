+static void debugcon_stop_at_exit(DebugconState *s, const uint8_t *reply,
+                                  unsigned int bytes)
+{
+    if (s->run_active && !s->run_failed && !s->output_length &&
+        current_cpu == s->run_cpu) {
+        memcpy(s->output, reply, bytes);
+        s->output_length = bytes;
+    } else {
+        s->run_failed = true;
+    }
+    vm_stop(RUN_STATE_PAUSED);
+}
