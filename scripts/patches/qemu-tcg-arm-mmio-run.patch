+#ifdef CONFIG_ARM_VIRT
+#define TYPE_FLEXVM_MMIO_RUN "flexvm-mmio-run"
+OBJECT_DECLARE_SIMPLE_TYPE(FlexvmMmioRun, FLEXVM_MMIO_RUN)
+
+struct FlexvmMmioRun {
+    DeviceState parent_obj;
+    DebugconState lane;
+    DebugconState second_lane;
+};
+
+static void flexvm_mmio_close_lane(DebugconState *lane)
+{
+    debugcon_run_failed(lane);
+    while (lane->read_width || lane->pio_waiters ||
+           lane->completion_ack_pending || lane->parallel_ack_pending) {
+        qemu_cond_wait_bql(&lane->read_completed);
+    }
+    qemu_chr_fe_set_handlers(&lane->chr, NULL, NULL, NULL, NULL,
+                             NULL, NULL, false);
+    qemu_del_vm_change_state_handler(lane->run_state);
+    lane->run_state = NULL;
+    qemu_cond_destroy(&lane->read_completed);
+}
+
+static void flexvm_mmio_run_realize(DeviceState *dev, Error **errp)
+{
+    FlexvmMmioRun *worker = FLEXVM_MMIO_RUN(dev);
+    DebugconState *lane = &worker->lane;
+    DebugconState *second = &worker->second_lane;
+    CPUState *cpu1 = qemu_get_cpu(1);
+    Error *err = NULL;
+
+    if (!lane->mmio_base || lane->mmio_base % DEBUGCON_MMIO_SIZE ||
+        lane->mmio_base > UINT64_MAX - DEBUGCON_MMIO_SIZE ||
+        !qemu_get_cpu(0) || qemu_get_cpu(2) ||
+        !!cpu1 != qemu_chr_fe_backend_connected(&second->chr)) {
+        error_setg(errp, "flexvm-mmio-run needs a page address and one socket per vCPU");
+        return;
+    }
+    lane->run_control = true;
+    if (cpu1) {
+        lane->run_cpu = qemu_get_cpu(0);
+        lane->parallel = true;
+        lane->other_lane = second;
+        second->run_cpu = cpu1;
+        second->parallel = second->run_control = true;
+        second->mmio_base = lane->mmio_base;
+    }
+    qemu_cond_init(&lane->read_completed);
+    debugcon_realize_core(lane, &err);
+    if (err) {
+        qemu_cond_destroy(&lane->read_completed);
+        error_propagate(errp, err);
+        return;
+    }
+    if (cpu1) {
+        qemu_cond_init(&second->read_completed);
+        debugcon_realize_core(second, &err);
+        if (err) {
+            qemu_cond_destroy(&second->read_completed);
+            flexvm_mmio_close_lane(lane);
+            error_propagate(errp, err);
+            return;
+        }
+    }
+
+    memory_region_init_io(&lane->mmio, OBJECT(dev), &debugcon_mmio_ops,
+                          lane, "flexvm-mmio", DEBUGCON_MMIO_SIZE);
+    memory_region_add_subregion(get_system_memory(), lane->mmio_base,
+                                &lane->mmio);
+}
+
+static void flexvm_mmio_run_unrealize(DeviceState *dev)
+{
+    DebugconState *lane = &FLEXVM_MMIO_RUN(dev)->lane;
+
+    if (lane->other_lane) {
+        flexvm_mmio_close_lane(lane->other_lane);
+    }
+    flexvm_mmio_close_lane(lane);
+    memory_region_del_subregion(get_system_memory(), &lane->mmio);
+    object_unparent(OBJECT(&lane->mmio));
+}
+
+static const Property flexvm_mmio_run_properties[] = {
+    DEFINE_PROP_CHR("chardev", FlexvmMmioRun, lane.chr),
+    DEFINE_PROP_CHR("parallel-chardev", FlexvmMmioRun, second_lane.chr),
+    DEFINE_PROP_UINT64("addr", FlexvmMmioRun, lane.mmio_base, 0),
+};
+
+static void flexvm_mmio_run_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = flexvm_mmio_run_realize;
+    dc->unrealize = flexvm_mmio_run_unrealize;
+    dc->hotpluggable = false;
+    device_class_set_props(dc, flexvm_mmio_run_properties);
+}
+
+static const TypeInfo flexvm_mmio_run_info = {
+    .name = TYPE_FLEXVM_MMIO_RUN,
+    .parent = TYPE_DEVICE,
+    .instance_size = sizeof(FlexvmMmioRun),
+    .class_init = flexvm_mmio_run_class_init,
+};
