 ##
 { 'command': 'x-flexvm-query-x86-sregs',
   'returns': 'FlexvmX86SpecialRegisters', 'features': [ 'unstable' ] }
+
+##
+# @x-flexvm-set-x86-protected-entry:
+#
+# Initialize the flat ring-zero protected-mode entry state of the
+# experimental FlexVM TCG worker before it runs.
+#
+# @gdt-base: The address of the guest descriptor table.
+# @gdt-limit: The table limit for three descriptors.
+#
+# Features:
+#
+# @unstable: Experimental FlexVM worker protocol.
+##
+{ 'command': 'x-flexvm-set-x86-protected-entry',
+  'data': { 'gdt-base': 'uint32', 'gdt-limit': 'uint16' },
+  'features': [ 'unstable' ] }
--- a/target/i386/monitor.c
+++ b/target/i386/monitor.c
@@ -691,3 +691,35 @@
     result->apic_base = cpu_get_apic_base(x86->apic_state);
     return result;
 }
+
+void qmp_x_flexvm_set_x86_protected_entry(uint32_t gdt_base,
+                                         uint16_t gdt_limit, Error **errp)
+{
+    CPUState *cpu = first_cpu;
+    CPUX86State *env;
+    const uint32_t data_flags = DESC_G_MASK | DESC_B_MASK | DESC_P_MASK |
+                                DESC_S_MASK | DESC_W_MASK | DESC_A_MASK;
+
+    if (!cpu || CPU_NEXT(cpu) || !tcg_enabled() ||
+        (!runstate_check(RUN_STATE_PRELAUNCH) &&
+         !runstate_check(RUN_STATE_PAUSED))) {
+        error_setg(errp, "FlexVM requires one stopped x86 TCG vCPU");
+        return;
+    }
+    env = &X86_CPU(cpu)->env;
+    if ((env->cr[0] & (CR0_PE_MASK | CR0_PG_MASK)) || gdt_limit != 23) {
+        error_setg(errp, "FlexVM requires initial flat protected-mode state");
+        return;
+    }
+
+    env->gdt.base = gdt_base;
+    env->gdt.limit = gdt_limit;
+    cpu_x86_update_cr0(env, env->cr[0] | CR0_PE_MASK);
+    cpu_x86_load_seg_cache(env, R_CS, 8, 0, UINT32_MAX,
+                          data_flags | DESC_CS_MASK);
+    const X86Seg data_registers[] = { R_DS, R_ES, R_FS, R_GS, R_SS };
+    for (size_t i = 0; i < ARRAY_SIZE(data_registers); i++) {
+        cpu_x86_load_seg_cache(env, data_registers[i], 16, 0, UINT32_MAX,
+                              data_flags);
+    }
+}
