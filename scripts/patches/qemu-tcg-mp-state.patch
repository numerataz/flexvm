+/* Values in the Linux x86 kvm_mp_state userspace ABI. */
+enum {
+    FLEXVM_MP_RUNNABLE = 0,
+    FLEXVM_MP_UNINITIALIZED = 1,
+    FLEXVM_MP_INIT_RECEIVED = 2,
+    FLEXVM_MP_HALTED = 3,
+    FLEXVM_MP_SIPI_RECEIVED = 4,
+    FLEXVM_MP_AP_RESET_HOLD = 9,
+};
+
+typedef struct FlexvmMpAccess {
+    bool write;
+    FlexvmX86MpRecord result;
+} FlexvmMpAccess;
+
+static void flexvm_access_mp_state(CPUState *cpu, run_on_cpu_data data)
+{
+    X86CPU *x86 = X86_CPU(cpu);
+    CPUX86State *env = &x86->env;
+    APICCommonState *apic = x86->apic_state;
+    FlexvmMpAccess *access = data.host_ptr;
+    const uint32_t state = access->result.state;
+    bool startup_blocked = (env->hflags & HF_SMM_MASK) ||
+                           !(env->hflags2 & HF2_GIF_MASK);
+
+    apic->flexvm_mp_managed = true;
+    if (access->write) {
+        if ((state > FLEXVM_MP_SIPI_RECEIVED && state != FLEXVM_MP_AP_RESET_HOLD) ||
+            ((state == FLEXVM_MP_INIT_RECEIVED || state == FLEXVM_MP_SIPI_RECEIVED) &&
+             (startup_blocked || (cpu->interrupt_request & CPU_INTERRUPT_SMI)))) {
+            access->result.status = -EINVAL;
+            return;
+        }
+        cpu->halted = state != FLEXVM_MP_RUNNABLE;
+        apic->wait_for_sipi = state == FLEXVM_MP_UNINITIALIZED ||
+                             state == FLEXVM_MP_INIT_RECEIVED ||
+                             state == FLEXVM_MP_SIPI_RECEIVED;
+        apic->flexvm_init_received = state == FLEXVM_MP_INIT_RECEIVED ||
+                                     state == FLEXVM_MP_SIPI_RECEIVED;
+        apic->flexvm_ap_reset_hold = state == FLEXVM_MP_AP_RESET_HOLD;
+        if (state == FLEXVM_MP_SIPI_RECEIVED) {
+            cpu_interrupt(cpu, CPU_INTERRUPT_SIPI);
+        }
+        return;
+    }
+    /* Like KVM_GET_MP_STATE, consume accepted startup events before reporting. */
+    if (!startup_blocked && (cpu->interrupt_request & CPU_INTERRUPT_INIT)) {
+        cpu_reset_interrupt(cpu, CPU_INTERRUPT_INIT);
+        do_cpu_init(x86);
+    }
+    /* Linux discards SIPIs while INIT/SIPI recognition is blocked. */
+    if (cpu->interrupt_request & CPU_INTERRUPT_SIPI) {
+        cpu_reset_interrupt(cpu, CPU_INTERRUPT_SIPI);
+        if (!startup_blocked && apic->flexvm_init_received) {
+            do_cpu_sipi(x86);
+        }
+    }
+    if (apic->wait_for_sipi) {
+        access->result.state = apic->flexvm_init_received ? FLEXVM_MP_INIT_RECEIVED :
+                                                           FLEXVM_MP_UNINITIALIZED;
+    } else if (cpu->halted) {
+        access->result.state = apic->flexvm_ap_reset_hold ? FLEXVM_MP_AP_RESET_HOLD :
+                                                           FLEXVM_MP_HALTED;
+    } else {
+        apic->flexvm_ap_reset_hold = false;
+        access->result.state = FLEXVM_MP_RUNNABLE;
+    }
+}
+
+FlexvmX86MpRecord *qmp_x_flexvm_access_x86_mp_state(uint16_t cpu_index,
+                                                  bool has_state, uint32_t state,
+                                                  Error **errp)
+{
+    CPUX86State *env = flexvm_stopped_cpu(cpu_index, errp);
+    FlexvmMpAccess access = {.write = has_state, .result.state = state};
+
+    if (!env) {
+        return NULL;
+    }
+    if (!env_archcpu(env)->apic_state) {
+        error_setg(errp, "FlexVM MP state requires an x86 APIC");
+        return NULL;
+    }
+    run_on_cpu(CPU(env_archcpu(env)), flexvm_access_mp_state, RUN_ON_CPU_HOST_PTR(&access));
+    return g_memdup2(&access.result, sizeof(access.result));
+}
