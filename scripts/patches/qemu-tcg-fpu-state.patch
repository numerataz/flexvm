+/* The KVM UAPI record uses FXSAVE's logical x87 stack ordering. */
+typedef struct FlexvmKvmFpu {
+    uint8_t st[8][16];
+    uint8_t control[2];
+    uint8_t status[2];
+    uint8_t nonempty;
+    uint8_t pad1;
+    uint8_t opcode[2];
+    uint8_t ip[8];
+    uint8_t dp[8];
+    uint8_t xmm[16][16];
+    uint8_t mxcsr_and_pad[8];
+} FlexvmKvmFpu;
+
+G_STATIC_ASSERT(sizeof(FlexvmKvmFpu) == 416);
+
+static CPUX86State *flexvm_fpu_cpu(uint16_t cpu_index, Error **errp)
+{
+    CPUState *cpu = qemu_get_cpu(cpu_index);
+
+    if (!cpu || !tcg_enabled() ||
+        (!runstate_check(RUN_STATE_PRELAUNCH) &&
+         !runstate_check(RUN_STATE_PAUSED))) {
+        error_setg(errp, "FlexVM requires a stopped x86 TCG vCPU");
+        return NULL;
+    }
+    return &X86_CPU(cpu)->env;
+}
+
+FlexvmX86FpuRecord *qmp_x_flexvm_query_x86_fpu(uint16_t cpu_index,
+                                               Error **errp)
+{
+    CPUX86State *env = flexvm_fpu_cpu(cpu_index, errp);
+    FlexvmKvmFpu state = { 0 };
+    const uint8_t *bytes = (const uint8_t *)&state;
+    static const char hex[] = "0123456789abcdef";
+    FlexvmX86FpuRecord *result;
+
+    if (!env) {
+        return NULL;
+    }
+    stw_le_p(state.control, env->fpuc);
+    stw_le_p(state.status, (env->fpus & ~0x3800) | (env->fpstt << 11));
+    stw_le_p(state.opcode, env->fpop);
+    stq_le_p(state.ip, env->fpip);
+    stq_le_p(state.dp, env->fpdp);
+    for (size_t i = 0; i < ARRAY_SIZE(state.st); i++) {
+        floatx80 st = env->fpregs[(i + env->fpstt) % 8].d;
+        state.nonempty |= !env->fptags[i] << i;
+        stq_le_p(state.st[i], st.low);
+        stw_le_p(state.st[i] + 8, st.high);
+    }
+    for (size_t i = 0; i < CPU_NB_REGS; i++) {
+        stq_le_p(state.xmm[i], env->xmm_regs[i].ZMM_Q(0));
+        stq_le_p(state.xmm[i] + 8, env->xmm_regs[i].ZMM_Q(1));
+    }
+    result = g_new0(FlexvmX86FpuRecord, 1);
+    result->record = g_malloc0(2 * sizeof(state) + 1);
+    for (size_t i = 0; i < sizeof(state); i++) {
+        result->record[2 * i] = hex[bytes[i] >> 4];
+        result->record[2 * i + 1] = hex[bytes[i] & 15];
+    }
+    return result;
+}
+
+void qmp_x_flexvm_set_x86_fpu(uint16_t cpu_index, const char *record,
+                             Error **errp)
+{
+    CPUX86State *env = flexvm_fpu_cpu(cpu_index, errp);
+    FlexvmKvmFpu state;
+    uint8_t *bytes = (uint8_t *)&state;
+    uint16_t status;
+
+    if (!env) {
+        return;
+    }
+    if (strlen(record) != 2 * sizeof(state)) {
+        error_setg(errp, "invalid FlexVM KVM_FPU record size");
+        return;
+    }
+    for (size_t i = 0; i < sizeof(state); i++) {
+        int high = g_ascii_xdigit_value(record[2 * i]);
+        int low = g_ascii_xdigit_value(record[2 * i + 1]);
+        if (high < 0 || low < 0) {
+            error_setg(errp, "invalid FlexVM KVM_FPU record encoding");
+            return;
+        }
+        bytes[i] = (high << 4) | low;
+    }
+    cpu_set_fpuc(env, lduw_le_p(state.control));
+    status = lduw_le_p(state.status);
+    env->fpstt = (status >> 11) & 7;
+    env->fpus = status & ~0x3800;
+    env->fpop = lduw_le_p(state.opcode);
+    env->fpip = ldq_le_p(state.ip);
+    env->fpdp = ldq_le_p(state.dp);
+    for (size_t i = 0; i < ARRAY_SIZE(state.st); i++) {
+        env->fptags[i] = !(state.nonempty & (1 << i));
+        env->fpregs[(i + env->fpstt) % 8].d =
+            make_floatx80(lduw_le_p(state.st[i] + 8), ldq_le_p(state.st[i]));
+    }
+    for (size_t i = 0; i < CPU_NB_REGS; i++) {
+        env->xmm_regs[i].ZMM_Q(0) = ldq_le_p(state.xmm[i]);
+        env->xmm_regs[i].ZMM_Q(1) = ldq_le_p(state.xmm[i] + 8);
+    }
+    /* Linux's KVM_FPU ioctl leaves MXCSR unchanged. */
+}
