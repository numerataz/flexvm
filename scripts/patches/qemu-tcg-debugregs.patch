+#ifdef CONFIG_TCG
+static void flexvm_set_debugregs(CPUState *cpu, run_on_cpu_data data)
+{
+    CPUX86State *env = &X86_CPU(cpu)->env;
+    const FlexvmX86DebugState *state = data.host_ptr;
+
+    /* Remove old breakpoints before changing the addresses. */
+    cpu_x86_update_dr7(env, DR7_FIXED_1);
+    env->dr[0] = state->dr0;
+    env->dr[1] = state->dr1;
+    env->dr[2] = state->dr2;
+    env->dr[3] = state->dr3;
+    env->dr[6] = state->dr6;
+    cpu_x86_update_dr7(env, state->dr7);
+    /* Preserve the ioctl image, including the guest's reserved bit 10. */
+    env->dr[7] = state->dr7;
+}
+#endif
+
+FlexvmX86DebugState *qmp_x_flexvm_access_x86_debugregs(uint16_t cpu_index,
+                                                     FlexvmX86DebugState *state,
+                                                     Error **errp)
+{
+    CPUX86State *env = flexvm_stopped_cpu(cpu_index, errp);
+    FlexvmX86DebugState *result;
+
+    if (!env) {
+        return NULL;
+    }
+#ifdef CONFIG_TCG
+    if (state) {
+        run_on_cpu(CPU(env_archcpu(env)), flexvm_set_debugregs, RUN_ON_CPU_HOST_PTR(state));
+    }
+#endif
+    result = g_new(FlexvmX86DebugState, 1);
+    *result = (FlexvmX86DebugState) {
+        .dr0 = env->dr[0], .dr1 = env->dr[1], .dr2 = env->dr[2], .dr3 = env->dr[3],
+        .dr6 = env->dr[6], .dr7 = env->dr[7],
+    };
+    return result;
+}
