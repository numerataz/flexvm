+FlexvmX86CpuidResult *qmp_x_flexvm_query_x86_cpuid(uint16_t cpu_index,
+                                                     FlexvmX86CpuidLeafList *entries,
+                                                     Error **errp)
+{
+    CPUX86State *env = flexvm_stopped_cpu(cpu_index, errp);
+    FlexvmX86CpuidResult *result;
+    FlexvmX86CpuidLeafList **tail;
+
+    if (!env) {
+        return NULL;
+    }
+    result = g_new0(FlexvmX86CpuidResult, 1);
+    tail = &result->entries;
+    for (; entries; entries = entries->next) {
+        FlexvmX86CpuidLeaf *leaf = g_memdup2(entries->value, sizeof(*leaf));
+
+        cpu_x86_cpuid(env, leaf->function, leaf->index,
+                      &leaf->eax, &leaf->ebx, &leaf->ecx, &leaf->edx);
+        QAPI_LIST_APPEND(tail, leaf);
+    }
+    return result;
+}
+
+void qmp_x_flexvm_set_x86_cpuid(uint16_t cpu_index,
+                                FlexvmX86CpuidLeafList *entries, Error **errp)
+{
+    CPUX86State *env = flexvm_stopped_cpu(cpu_index, errp);
+    g_autoptr(GArray) profile = NULL;
+    X86CPU *cpu;
+
+    if (!env) {
+        return;
+    }
+    cpu = env_archcpu(env);
+    if (cpu->flexvm_cpuid) {
+        error_setg(errp, "FlexVM CPUID state is already configured");
+        return;
+    }
+    profile = g_array_new(false, false, sizeof(FlexvmCpuidEntry));
+    for (; entries; entries = entries->next) {
+        const FlexvmX86CpuidLeaf *leaf = entries->value;
+        FlexvmCpuidEntry entry = {
+            .function = leaf->function, .index = leaf->index,
+            .eax = leaf->eax, .ebx = leaf->ebx, .ecx = leaf->ecx,
+            .edx = leaf->edx, .indexed = leaf->indexed,
+        };
+
+        if (profile->len == 128) {
+            error_setg(errp, "FlexVM requires a bounded CPUID table");
+            return;
+        }
+        for (unsigned int i = 0; i < profile->len; i++) {
+            const FlexvmCpuidEntry *prior =
+                &g_array_index(profile, FlexvmCpuidEntry, i);
+
+            if (entry.function == prior->function &&
+                (!entry.indexed || !prior->indexed ||
+                 entry.index == prior->index)) {
+                error_setg(errp, "FlexVM CPUID functions must be distinct");
+                return;
+            }
+        }
+        g_array_append_val(profile, entry);
+    }
+    cpu->flexvm_cpuid = g_steal_pointer(&profile);
+}
