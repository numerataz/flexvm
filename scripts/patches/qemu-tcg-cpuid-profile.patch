+static const FlexvmCpuidEntry *find_flexvm_cpuid(const GArray *profile,
+                                                uint32_t function,
+                                                uint32_t index)
+{
+    for (unsigned int i = 0; i < profile->len; i++) {
+        const FlexvmCpuidEntry *entry =
+            &g_array_index(profile, FlexvmCpuidEntry, i);
+
+        if (entry->function == function &&
+            (!entry->indexed || entry->index == index)) {
+            return entry;
+        }
+    }
+    return NULL;
+}
+
+static bool flexvm_cpuid_vendor_is_amd(const FlexvmCpuidEntry *root)
+{
+    char vendor[12];
+
+    stl_le_p(vendor, root->ebx);
+    stl_le_p(vendor + 4, root->edx);
+    stl_le_p(vendor + 8, root->ecx);
+    return !memcmp(vendor, CPUID_VENDOR_AMD, sizeof(vendor)) ||
+           !memcmp(vendor, CPUID_VENDOR_HYGON, sizeof(vendor));
+}
+
+static const FlexvmCpuidEntry *flexvm_cpuid_fallback(const GArray *profile,
+                                                   uint32_t *function,
+                                                   uint32_t index)
+{
+    const FlexvmCpuidEntry *root = find_flexvm_cpuid(profile, 0, 0);
+    const FlexvmCpuidEntry *range;
+    uint32_t base;
+
+    if (!root || flexvm_cpuid_vendor_is_amd(root)) {
+        return NULL;
+    }
+    if (*function >= 0x40000000 && *function < 0x50000000) {
+        base = *function & 0xffffff00;
+    } else if (*function >= 0xc0000000) {
+        base = 0xc0000000;
+    } else {
+        base = *function & 0x80000000;
+    }
+    range = find_flexvm_cpuid(profile, base, 0);
+    if (range && *function <= range->eax) {
+        return NULL;
+    }
+    *function = root->eax;
+    return find_flexvm_cpuid(profile, *function, index);
+}
+
+static uint32_t flexvm_xsave_size(const GArray *profile, CPUX86State *env,
+                                uint32_t index, const FlexvmCpuidEntry *entry)
+{
+    const FlexvmCpuidEntry *root = find_flexvm_cpuid(profile, 0xd, 0);
+    uint64_t enabled, supervisor;
+
+    if (!root || !(root->eax || root->edx)) {
+        return entry->ebx;
+    }
+    enabled = env->xcr0 & (((uint64_t)root->edx << 32) | root->eax);
+    if (!index) {
+        return xsave_area_size(enabled, false);
+    }
+    if (!(entry->eax & (CPUID_XSAVE_XSAVEC | CPUID_XSAVE_XSAVES))) {
+        return entry->ebx;
+    }
+    supervisor = env->xss & (((uint64_t)entry->edx << 32) | entry->ecx);
+    return xsave_area_size(enabled | supervisor, true);
+}
