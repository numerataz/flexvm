@@ -53,3 +53,8 @@
 {
     error_setg(errp, "FlexVM CPUID requires an x86 worker");
 }
+
+void qmp_x_flexvm_set_x86_gsi(uint32_t gsi, bool level, Error **errp)
+{
+    error_setg(errp, "FlexVM interrupts require an x86 PC worker");
+}
