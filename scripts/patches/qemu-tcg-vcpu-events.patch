+#define FLEXVM_EVENT_NMI_PENDING 1
+#define FLEXVM_EVENT_SIPI_VECTOR 2
+#define FLEXVM_EVENT_SHADOW 4
+#define FLEXVM_EVENT_SMM 8
+#define FLEXVM_EVENT_READ_FLAGS (FLEXVM_EVENT_NMI_PENDING | FLEXVM_EVENT_SHADOW | FLEXVM_EVENT_SMM)
+
+typedef struct FlexvmEventAccess {
+    bool write;
+    bool irqchip;
+    int status;
+    uint8_t record[64];
+} FlexvmEventAccess;
+
+static void flexvm_event_signal(CPUState *cpu, int interrupt, bool enabled)
+{
+    if (enabled) {
+        cpu_interrupt(cpu, interrupt);
+    } else {
+        cpu_reset_interrupt(cpu, interrupt);
+    }
+}
+
+static void flexvm_write_vcpu_events(CPUState *cpu, FlexvmEventAccess *access)
+{
+    X86CPU *x86 = X86_CPU(cpu);
+    CPUX86State *env = &x86->env;
+    APICCommonState *apic = x86->apic_state;
+    const uint8_t *record = access->record;
+    uint32_t flags = ldl_le_p(record + 20);
+
+    if ((flags & ~(FLEXVM_EVENT_READ_FLAGS | FLEXVM_EVENT_SIPI_VECTOR)) ||
+        (record[0] && (record[1] > 31 || record[1] == EXCP02_NMI)) ||
+        ((flags & FLEXVM_EVENT_SMM) && apic && apic->flexvm_init_received &&
+         (record[24] || record[25]))) {
+        access->status = -EINVAL;
+        return;
+    }
+    env->flexvm_events.exception_injected = record[0];
+    env->flexvm_events.exception_vector = record[1];
+    env->flexvm_events.exception_has_error = record[2];
+    env->flexvm_events.error_code = ldl_le_p(record + 4);
+    env->flexvm_events.interrupt_injected = record[8];
+    env->flexvm_events.interrupt_vector = record[9];
+    env->flexvm_events.interrupt_soft = record[10];
+    env->flexvm_events.nmi_injected = record[12];
+    flexvm_event_signal(cpu, CPU_INTERRUPT_FLEXVM_EVENTS,
+                        record[0] || record[8] || record[12]);
+
+    if (flags & FLEXVM_EVENT_SHADOW) {
+        env->flexvm_events.irq_shadow = record[11] & 3;
+        env->hflags = (env->hflags & ~HF_INHIBIT_IRQ_MASK) |
+                      (env->flexvm_events.irq_shadow ? HF_INHIBIT_IRQ_MASK : 0);
+    }
+    if (flags & FLEXVM_EVENT_NMI_PENDING) {
+        flexvm_event_signal(cpu, CPU_INTERRUPT_NMI, record[13] != 0);
+    }
+    env->hflags2 = (env->hflags2 & ~HF2_NMI_MASK) | (record[14] ? HF2_NMI_MASK : 0);
+    if ((flags & FLEXVM_EVENT_SIPI_VECTOR) && access->irqchip && apic) {
+        apic->sipi_vector = ldl_le_p(record + 16) & 0xff;
+    }
+    if (flags & FLEXVM_EVENT_SMM) {
+        env->hflags = (env->hflags & ~HF_SMM_MASK) | (record[24] ? HF_SMM_MASK : 0);
+        env->hflags2 = (env->hflags2 & ~HF2_SMM_INSIDE_NMI_MASK) |
+                       (record[24] && record[26] ? HF2_SMM_INSIDE_NMI_MASK : 0);
+        flexvm_event_signal(cpu, CPU_INTERRUPT_SMI, record[25] != 0);
+        /* The saved INIT becomes a deliverable event after RSM. */
+        env->flexvm_events.latched_init = access->irqchip && record[24] && record[27];
+        if (access->irqchip) {
+            flexvm_event_signal(cpu, CPU_INTERRUPT_INIT, !record[24] && record[27]);
+        }
+    }
+}
+
+static void flexvm_access_vcpu_events(CPUState *cpu, run_on_cpu_data data)
+{
+    CPUX86State *env = &X86_CPU(cpu)->env;
+    FlexvmEventAccess *access = data.host_ptr;
+    uint8_t *record = access->record;
+
+    if (access->write) {
+        flexvm_write_vcpu_events(cpu, access);
+        return;
+    }
+    /* The Linux KVM GET ABI suppresses software delivery and never returns a SIPI vector. */
+    record[0] = env->flexvm_events.exception_injected &&
+                env->flexvm_events.exception_vector != EXCP03_INT3 &&
+                env->flexvm_events.exception_vector != EXCP04_INTO;
+    record[1] = env->flexvm_events.exception_vector;
+    record[2] = env->flexvm_events.exception_has_error;
+    stl_le_p(record + 4, env->flexvm_events.error_code);
+    record[8] = env->flexvm_events.interrupt_injected && !env->flexvm_events.interrupt_soft;
+    record[9] = env->flexvm_events.interrupt_vector;
+    if (env->hflags & HF_INHIBIT_IRQ_MASK) {
+        record[11] = env->flexvm_events.irq_shadow ?: 3;
+    }
+    record[12] = env->flexvm_events.nmi_injected;
+    record[13] = cpu_test_interrupt(cpu, CPU_INTERRUPT_NMI);
+    record[14] = (env->hflags2 & HF2_NMI_MASK) != 0;
+    stl_le_p(record + 20, FLEXVM_EVENT_READ_FLAGS);
+    record[24] = (env->hflags & HF_SMM_MASK) != 0;
+    record[25] = cpu_test_interrupt(cpu, CPU_INTERRUPT_SMI);
+    record[26] = (env->hflags2 & HF2_SMM_INSIDE_NMI_MASK) != 0;
+    record[27] = access->irqchip && (env->flexvm_events.latched_init ||
+                                       cpu_test_interrupt(cpu, CPU_INTERRUPT_INIT));
+}
+
+FlexvmX86VcpuEvents *qmp_x_flexvm_access_x86_vcpu_events(uint16_t cpu_index,
+                                                        bool irqchip,
+                                                        const char *record,
+                                                        Error **errp)
+{
+    static const char hex[] = "0123456789abcdef";
+    CPUX86State *env = flexvm_stopped_cpu(cpu_index, errp);
+    FlexvmEventAccess access = {.write = record != NULL, .irqchip = irqchip};
+    FlexvmX86VcpuEvents *result;
+
+    if (!env) {
+        return NULL;
+    }
+    if (record) {
+        if (strlen(record) != 2 * sizeof(access.record)) {
+            error_setg(errp, "Invalid FlexVM vCPU event record size");
+            return NULL;
+        }
+        for (size_t i = 0; i < sizeof(access.record); i++) {
+            int high = g_ascii_xdigit_value(record[2 * i]);
+            int low = g_ascii_xdigit_value(record[2 * i + 1]);
+
+            if (high < 0 || low < 0) {
+                error_setg(errp, "Invalid hex in FlexVM vCPU events");
+                return NULL;
+            }
+            access.record[i] = (high << 4) | low;
+        }
+    }
+    run_on_cpu(CPU(env_archcpu(env)), flexvm_access_vcpu_events, RUN_ON_CPU_HOST_PTR(&access));
+    result = g_new0(FlexvmX86VcpuEvents, 1);
+    result->status = access.status;
+    result->record = g_malloc(2 * sizeof(access.record) + 1);
+    for (size_t i = 0; i < sizeof(access.record); i++) {
+        result->record[2 * i] = hex[access.record[i] >> 4];
+        result->record[2 * i + 1] = hex[access.record[i] & 15];
+    }
+    result->record[2 * sizeof(access.record)] = '\0';
+    return result;
+}
