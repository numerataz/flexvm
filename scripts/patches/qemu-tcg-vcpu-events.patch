+static void x86_flexvm_inject_event(X86CPU *cpu)
+{
+    CPUX86State *env = &cpu->env;
+
+    if (env->flexvm_events.exception_injected) {
+        env->flexvm_events.exception_injected = false;
+        x86_flexvm_deliver_exception(cpu, env->flexvm_events.exception_vector,
+                                     env->flexvm_events.exception_has_error,
+                                     env->flexvm_events.error_code);
+    } else if (env->flexvm_events.nmi_injected) {
+        env->flexvm_events.nmi_injected = false;
+        env->hflags2 |= HF2_NMI_MASK;
+        do_interrupt_x86_hardirq(env, EXCP02_NMI, 1);
+    } else if (env->flexvm_events.interrupt_injected) {
+        bool soft = env->flexvm_events.interrupt_soft;
+
+        env->flexvm_events.interrupt_injected = false;
+        do_interrupt_all(cpu, env->flexvm_events.interrupt_vector, soft,
+                         0, env->eip, !soft);
+    }
+    if (!env->flexvm_events.exception_injected && !env->flexvm_events.interrupt_injected &&
+        !env->flexvm_events.nmi_injected) {
+        cpu_reset_interrupt(CPU(cpu), CPU_INTERRUPT_FLEXVM_EVENTS);
+    }
+}
