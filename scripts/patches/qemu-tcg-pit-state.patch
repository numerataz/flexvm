+FlexvmX86PitRecord *qmp_x_flexvm_access_x86_pit(const char *record, Error **errp)
+{
+    static const char hex[] = "0123456789abcdef";
+    uint8_t bytes[FLEXVM_PIT_STATE_SIZE] = { 0 };
+    FlexvmX86PitRecord *result;
+    bool ambiguous = false;
+    Object *pit;
+    bool speaker_data;
+
+    if (!flexvm_stopped_cpu(0, errp)) {
+        return NULL;
+    }
+    pit = object_resolve_path_type("", TYPE_I8254, &ambiguous);
+    if (!pit || ambiguous) {
+        error_setg(errp, "FlexVM requires exactly one emulated i8254");
+        return NULL;
+    }
+    if (record) {
+        if (strlen(record) != 2 * sizeof(bytes)) {
+            error_setg(errp, "Invalid FlexVM PIT image size");
+            return NULL;
+        }
+        for (size_t i = 0; i < sizeof(bytes); i++) {
+            int high = g_ascii_xdigit_value(record[2 * i]);
+            int low = g_ascii_xdigit_value(record[2 * i + 1]);
+
+            if (high < 0 || low < 0) {
+                error_setg(errp, "Invalid hex in FlexVM PIT image");
+                return NULL;
+            }
+            bytes[i] = (high << 4) | low;
+        }
+    }
+    speaker_data = (bytes[FLEXVM_PIT_FLAGS_OFFSET] & FLEXVM_PIT_SPEAKER_DATA_ON) != 0;
+    if (!flexvm_pit_state(PIT_COMMON(pit), record != NULL, bytes)) {
+        error_setg(errp, "Invalid FlexVM PIT state");
+        return NULL;
+    }
+    if (flexvm_pcspk_data_on(record != NULL, speaker_data)) {
+        bytes[FLEXVM_PIT_FLAGS_OFFSET] |= FLEXVM_PIT_SPEAKER_DATA_ON;
+    }
+    result = g_new(FlexvmX86PitRecord, 1);
+    result->record = g_malloc(2 * sizeof(bytes) + 1);
+    for (size_t i = 0; i < sizeof(bytes); i++) {
+        result->record[2 * i] = hex[bytes[i] >> 4];
+        result->record[2 * i + 1] = hex[bytes[i] & 15];
+    }
+    result->record[2 * sizeof(bytes)] = '\0';
+    return result;
 }
