+/* Layout of the x86 KVM PIT_STATE2 userspace record. */
+#define FLEXVM_PIT_CHANNEL_SIZE 24
+#define FLEXVM_PIT_HPET_LEGACY 1
+
+static void flexvm_pit_channel(PITChannelState *s, bool write, uint8_t *record,
+                               int64_t now)
+{
+    if (write) {
+        uint32_t count = ldl_le_p(record);
+
+        s->count = count ? count : 65536;
+        s->latched_count = lduw_le_p(record + 4);
+        s->count_latched = record[6];
+        s->status_latched = record[7];
+        s->status = record[8];
+        s->read_state = record[9];
+        s->write_state = record[10];
+        s->write_latch = record[11];
+        s->rw_mode = record[12];
+        s->mode = record[13];
+        s->bcd = record[14];
+        s->gate = record[15];
+        /* KVM reloads the counters at SET_PIT2, using its local clock. */
+        s->count_load_time = now;
+    } else {
+        stl_le_p(record, s->count);
+        stw_le_p(record + 4, s->latched_count);
+        record[6] = s->count_latched;
+        record[7] = s->status_latched;
+        record[8] = s->status;
+        record[9] = s->read_state;
+        record[10] = s->write_state;
+        record[11] = s->write_latch;
+        record[12] = s->rw_mode;
+        record[13] = s->mode;
+        record[14] = s->bcd;
+        record[15] = s->gate;
+        stq_le_p(record + 16, s->count_load_time);
+    }
+}
+
+bool flexvm_pit_state(PITCommonState *pit, bool write,
+                      uint8_t record[FLEXVM_PIT_STATE_SIZE])
+{
+    PITChannelState *channel0 = &pit->channels[0];
+    const int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    const uint32_t flags = ldl_le_p(record + FLEXVM_PIT_FLAGS_OFFSET);
+
+    if (write) {
+        if (flags & ~(FLEXVM_PIT_HPET_LEGACY | FLEXVM_PIT_SPEAKER_DATA_ON)) {
+            return false;
+        }
+        for (size_t i = 0; i < ARRAY_SIZE(pit->channels); i++) {
+            uint8_t *channel = record + i * FLEXVM_PIT_CHANNEL_SIZE;
+
+            if (ldl_le_p(channel) > 65536 || channel[6] > 3 ||
+                channel[7] > 1 || channel[9] > 4 || channel[10] > 4 ||
+                channel[12] > 3 || (channel[13] > 7 && channel[13] != 0xff) ||
+                channel[14] > 1 || channel[15] > 1) {
+                return false;
+            }
+        }
+        for (size_t i = 0; i < ARRAY_SIZE(pit->channels); i++) {
+            flexvm_pit_channel(&pit->channels[i], true,
+                               record + i * FLEXVM_PIT_CHANNEL_SIZE, now);
+        }
+        channel0->irq_disabled = (flags & FLEXVM_PIT_HPET_LEGACY) != 0;
+        if (channel0->irq_disabled || channel0->mode > 5) {
+            timer_del(channel0->irq_timer);
+            channel0->next_transition_time = -1;
+            qemu_set_irq(channel0->irq, 0);
+        } else {
+            pit_irq_timer_update(channel0, now);
+        }
+    }
+    memset(record, 0, FLEXVM_PIT_STATE_SIZE);
+    for (size_t i = 0; i < ARRAY_SIZE(pit->channels); i++) {
+        flexvm_pit_channel(&pit->channels[i], false,
+                           record + i * FLEXVM_PIT_CHANNEL_SIZE, now);
+    }
+    stl_le_p(record + FLEXVM_PIT_FLAGS_OFFSET,
+             channel0->irq_disabled ? FLEXVM_PIT_HPET_LEGACY : 0);
+    return true;
+}

