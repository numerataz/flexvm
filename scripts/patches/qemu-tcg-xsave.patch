+typedef struct FlexvmXsaveAccess {
+    bool write;
+    int status;
+    uint8_t image[FLEXVM_XSAVE_SIZE];
+} FlexvmXsaveAccess;
+
+static void flexvm_access_xsave(CPUState *cpu, run_on_cpu_data data)
+{
+    FlexvmXsaveAccess *access = data.host_ptr;
+
+    if (!x86_cpu_flexvm_xsave(X86_CPU(cpu), access->write, access->image)) {
+        access->status = -EINVAL;
+    }
+}
+
+FlexvmX86XsaveRecord *qmp_x_flexvm_access_x86_xsave(uint16_t cpu_index,
+                                                  const char *record,
+                                                  Error **errp)
+{
+    static const char hex[] = "0123456789abcdef";
+    CPUX86State *env = flexvm_stopped_cpu(cpu_index, errp);
+    g_autofree FlexvmXsaveAccess *access = NULL;
+    FlexvmX86XsaveRecord *result;
+
+    if (!env) {
+        return NULL;
+    }
+    access = g_new0(FlexvmXsaveAccess, 1);
+    access->write = record != NULL;
+    if (record) {
+        if (strlen(record) != 2 * sizeof(access->image)) {
+            error_setg(errp, "Invalid FlexVM XSAVE image size");
+            return NULL;
+        }
+        for (size_t i = 0; i < sizeof(access->image); i++) {
+            int high = g_ascii_xdigit_value(record[2 * i]);
+            int low = g_ascii_xdigit_value(record[2 * i + 1]);
+
+            if (high < 0 || low < 0) {
+                error_setg(errp, "Invalid hex in FlexVM XSAVE image");
+                return NULL;
+            }
+            access->image[i] = (high << 4) | low;
+        }
+    }
+    run_on_cpu(CPU(env_archcpu(env)), flexvm_access_xsave, RUN_ON_CPU_HOST_PTR(access));
+    result = g_new0(FlexvmX86XsaveRecord, 1);
+    result->status = access->status;
+    if (access->write) {
+        result->record = g_strdup("");
+    } else {
+        result->record = g_malloc(2 * sizeof(access->image) + 1);
+        for (size_t i = 0; i < sizeof(access->image); i++) {
+            result->record[2 * i] = hex[access->image[i] >> 4];
+            result->record[2 * i + 1] = hex[access->image[i] & 15];
+        }
+        result->record[2 * sizeof(access->image)] = '\0';
+    }
+    return result;
+}
