+#ifndef CONFIG_USER_ONLY
+static uint64_t flexvm_xsave_mask(CPUX86State *env)
+{
+    uint32_t low, high, ignored;
+    uint64_t mask;
+
+    cpu_x86_cpuid(env, 0x0d, 0, &low, &ignored, &ignored, &high);
+    mask = (uint64_t)(high & env->features[FEAT_XSAVE_XCR0_HI]) << 32;
+    mask |= low & env->features[FEAT_XSAVE_XCR0_LO];
+    mask |= XSTATE_FP_MASK | XSTATE_SSE_MASK;
+    for (unsigned int i = 2; i < ARRAY_SIZE(x86_ext_save_areas); i++) {
+        const ExtSaveArea *area = &x86_ext_save_areas[i];
+
+        if (!area->offset || !area->size ||
+            area->offset + area->size > FLEXVM_XSAVE_SIZE) {
+            mask &= ~(1ULL << i);
+        }
+    }
+    return mask;
+}
+
+static bool flexvm_xsave_header_valid(const X86XSaveHeader *header, uint64_t supported)
+{
+    if (header->xstate_bv & ~supported || header->xcomp_bv || header->reserve0) {
+        return false;
+    }
+    for (size_t i = 0; i < sizeof(header->reserved); i++) {
+        if (header->reserved[i]) {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool x86_cpu_flexvm_xsave(X86CPU *cpu, bool write, uint8_t image[FLEXVM_XSAVE_SIZE])
+{
+    CPUX86State *env = &cpu->env;
+    uint32_t size = MAX(FLEXVM_XSAVE_SIZE, xsave_area_size(UINT64_MAX, false));
+    g_autofree uint8_t *buffer = g_malloc0(size);
+    X86LegacyXSaveArea *legacy = (void *)buffer;
+    X86XSaveHeader *header = (void *)(buffer + sizeof(*legacy));
+    uint64_t supported = flexvm_xsave_mask(env);
+    uint64_t present;
+
+    if (write) {
+        memcpy(buffer, image, FLEXVM_XSAVE_SIZE);
+        if (!flexvm_xsave_header_valid(header, supported) ||
+            (legacy->mxcsr & 0xffff0000)) {
+            return false;
+        }
+        present = header->xstate_bv;
+        if (!(present & XSTATE_FP_MASK)) {
+            memset(legacy, 0, offsetof(X86LegacyXSaveArea, mxcsr));
+            memset(legacy->fpregs, 0, sizeof(legacy->fpregs));
+            legacy->fcw = 0x37f;
+        }
+        if (!(present & XSTATE_SSE_MASK)) {
+            memset(legacy->xmm_regs, 0, sizeof(legacy->xmm_regs));
+        }
+        if (!(present & (XSTATE_SSE_MASK | XSTATE_YMM_MASK))) {
+            legacy->mxcsr = 0x1f80;
+        }
+    } else {
+        x86_cpu_xsave_all_areas(cpu, buffer, size);
+        /* TCG tracks registers directly, including components currently disabled in XCR0. */
+        present = supported;
+        header->xstate_bv = present;
+    }
+
+    for (unsigned int i = 2; i < ARRAY_SIZE(x86_ext_save_areas); i++) {
+        const ExtSaveArea *area = &x86_ext_save_areas[i];
+
+        if (area->offset && area->size && !(present & (1ULL << i))) {
+            memset(buffer + area->offset, 0, area->size);
+        }
+    }
+    if (write) {
+        uint32_t old_pkru = env->pkru;
+
+        x86_cpu_xrstor_all_areas(cpu, buffer, size);
+        cpu_set_fpuc(env, env->fpuc);
+        cpu_set_mxcsr(env, env->mxcsr);
+        cpu_sync_bndcs_hflags(env);
+        if (old_pkru != env->pkru) {
+            tlb_flush(CPU(cpu));
+        }
+    } else {
+        memcpy(image, buffer, FLEXVM_XSAVE_SIZE);
+    }
+    return true;
+}
+#endif
