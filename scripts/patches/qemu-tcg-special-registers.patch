+##
+# @FlexvmX86SpecialRegisters:
+#
+# Live x86 special registers from a stopped worker vCPU.
+#
+# @segments: CS, DS, ES, FS, GS, SS, TR, and LDT, in that order.
+# @gdt-base: The GDT base.
+# @gdt-limit: The GDT limit.
+# @idt-base: The IDT base.
+# @idt-limit: The IDT limit.
+# @cr0: The CR0 register.
+# @cr2: The CR2 register.
+# @cr3: The CR3 register.
+# @cr4: The CR4 register.
+# @cr8: The APIC task priority register in CR8 units.
+# @efer: The EFER register.
+# @apic-base: The APIC base MSR.
+##
+{ 'struct': 'FlexvmX86SpecialRegisters',
+  'data': { 'segments': [ 'FlexvmX86Segment' ],
+            'gdt-base': 'uint64', 'gdt-limit': 'uint16',
+            'idt-base': 'uint64', 'idt-limit': 'uint16',
+            'cr0': 'uint64', 'cr2': 'uint64', 'cr3': 'uint64',
+            'cr4': 'uint64', 'cr8': 'uint64', 'efer': 'uint64',
+            'apic-base': 'uint64' } }
+
+##
+# @x-flexvm-query-x86-sregs:
+#
+# Query special registers from the experimental FlexVM TCG worker.
+#
+# Features:
+#
+# @unstable: Experimental FlexVM worker protocol.
+#
+# Returns: Special registers of the single stopped vCPU.
+##
+{ 'command': 'x-flexvm-query-x86-sregs',
+  'returns': 'FlexvmX86SpecialRegisters', 'features': [ 'unstable' ] }
