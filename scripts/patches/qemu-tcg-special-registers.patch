 {
     return monitor_defs;
 }
+
+FlexvmX86SpecialRegisters *qmp_x_flexvm_query_x86_sregs(Error **errp)
+{
+    CPUState *cpu = first_cpu;
+    X86CPU *x86;
+    CPUX86State *env;
+    FlexvmX86SpecialRegisters *result;
+    FlexvmX86SegmentList **tail;
+
+    if (!cpu || CPU_NEXT(cpu) || !tcg_enabled() ||
+        !runstate_check(RUN_STATE_PAUSED)) {
+        error_setg(errp, "FlexVM requires one paused x86 TCG vCPU");
+        return NULL;
+    }
+    x86 = X86_CPU(cpu);
+    env = &x86->env;
+    result = g_new0(FlexvmX86SpecialRegisters, 1);
+    tail = &result->segments;
+    const SegmentCache *segments[] = {
+        &env->segs[R_CS], &env->segs[R_DS], &env->segs[R_ES],
+        &env->segs[R_FS], &env->segs[R_GS], &env->segs[R_SS],
+        &env->tr, &env->ldt,
+    };
+
+    for (size_t i = 0; i < ARRAY_SIZE(segments); i++) {
+        const SegmentCache *cache = segments[i];
+        FlexvmX86Segment *segment = g_new(FlexvmX86Segment, 1);
+        segment->selector = cache->selector;
+        segment->base = cache->base;
+        segment->limit = cache->limit;
+        segment->flags = cache->flags;
+        QAPI_LIST_APPEND(tail, segment);
+    }
+    result->gdt_base = env->gdt.base;
+    result->gdt_limit = env->gdt.limit;
+    result->idt_base = env->idt.base;
+    result->idt_limit = env->idt.limit;
+    result->cr0 = env->cr[0];
+    result->cr2 = env->cr[2];
+    result->cr3 = env->cr[3];
+    result->cr4 = env->cr[4];
+    result->cr8 = cpu_get_apic_tpr(x86->apic_state);
+    result->efer = env->efer;
+    result->apic_base = cpu_get_apic_base(x86->apic_state);
+    return result;
+}
