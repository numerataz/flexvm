--- a/target/i386/monitor.c
+++ b/target/i386/monitor.c
@@ -1350 +1350,34 @@
 }
+
+#ifdef CONFIG_TCG
+static void flexvm_set_xcr0(CPUState *cpu, run_on_cpu_data data)
+{
+    CPUX86State *env = &X86_CPU(cpu)->env;
+    FlexvmX86Xcr0 *state = data.host_ptr;
+
+    if (!x86_cpu_set_xcr0(env, state->value)) {
+        state->status = -EINVAL;
+    }
+}
+#endif
+
+FlexvmX86Xcr0 *qmp_x_flexvm_access_x86_xcr0(uint16_t cpu_index,
+                                           bool has_value, uint64_t value,
+                                           Error **errp)
+{
+    CPUX86State *env = flexvm_stopped_cpu(cpu_index, errp);
+    FlexvmX86Xcr0 *result;
+
+    if (!env) {
+        return NULL;
+    }
+    result = g_new0(FlexvmX86Xcr0, 1);
+#ifdef CONFIG_TCG
+    if (has_value) {
+        result->value = value;
+        run_on_cpu(CPU(env_archcpu(env)), flexvm_set_xcr0, RUN_ON_CPU_HOST_PTR(result));
+    }
+#endif
+    result->value = env->xcr0;
+    return result;
+}
