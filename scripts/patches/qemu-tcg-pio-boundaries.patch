+static IOPortInterceptor *port_interceptor;
+static void *port_interceptor_owner;
+
+bool cpu_register_ioport_interceptor(IOPortInterceptor *intercept, void *opaque)
+{
+    assert(bql_locked());
+    if (port_interceptor) {
+        return false;
+    }
+    port_interceptor_owner = opaque;
+    qatomic_set(&port_interceptor, intercept);
+    return true;
+}
+
+void cpu_unregister_ioport_interceptor(void *opaque)
+{
+    assert(bql_locked());
+    assert(port_interceptor && port_interceptor_owner == opaque);
+    qatomic_set(&port_interceptor, NULL);
+    port_interceptor_owner = NULL;
+}
+
+bool cpu_intercept_ioport(uint32_t port, unsigned int width, bool write,
+                                 uint32_t *value)
+{
+    bool handled = false;
+    bool already_locked;
+
+    if (!qatomic_read(&port_interceptor) || !qemu_in_vcpu_thread()) {
+        return false;
+    }
+    already_locked = bql_locked();
+    if (!already_locked) {
+        bql_lock();
+    }
+    if (port_interceptor) {
+        handled = port_interceptor(port_interceptor_owner, port, width,
+                                   write, value);
+    }
+    if (!already_locked) {
+        bql_unlock();
+    }
+    return handled;
+}
+
 void cpu_outb(uint32_t addr, uint8_t val)
