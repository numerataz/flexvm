+
+bool flexvm_ioapic_state(bool write, uint8_t record[FLEXVM_IOAPIC_IMAGE_SIZE])
+{
+    IOAPICCommonState *s = ioapics[0];
+    uint64_t address;
+
+    if (!s) {
+        return false;
+    }
+    address = s->busdev.mmio[0].addr;
+    if (write) {
+        uint32_t masked = 0;
+
+        if (ldq_le_p(record) != address || ldl_le_p(record + 8) > UINT8_MAX ||
+            ldl_le_p(record + 12) > UINT8_MAX ||
+            ldl_le_p(record + 16) >= (1U << IOAPIC_NUM_PINS) ||
+            ldl_le_p(record + 20)) {
+            return false;
+        }
+        s->ioregsel = ldl_le_p(record + 8);
+        s->id = ldl_le_p(record + 12);
+        s->irr = ldl_le_p(record + 16);
+        for (unsigned int i = 0; i < IOAPIC_NUM_PINS; i++) {
+            s->ioredtbl[i] = ldq_le_p(record + 24 + i * 8);
+            if (s->ioredtbl[i] & IOAPIC_LVT_MASKED) {
+                masked |= 1U << i;
+            }
+        }
+        /* A masked request remains pending when the image is installed. */
+        masked &= s->irr;
+        s->irr &= ~masked;
+        ioapic_service(s);
+        s->irr |= masked;
+    } else {
+        stq_le_p(record, address);
+        stl_le_p(record + 8, s->ioregsel);
+        stl_le_p(record + 12, s->id);
+        stl_le_p(record + 16, s->irr);
+        stl_le_p(record + 20, 0);
+        for (unsigned int i = 0; i < IOAPIC_NUM_PINS; i++) {
+            stq_le_p(record + 24 + i * 8, s->ioredtbl[i]);
+        }
+    }
+    return true;
+}

