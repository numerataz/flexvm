+bool flexvm_pic_state(bool master, bool write, uint8_t record[FLEXVM_PIC_IMAGE_SIZE])
+{
+    PICCommonState *s = master ? isa_pic : slave_pic;
+
+    if (!s) {
+        return false;
+    }
+    if (write) {
+        s->last_irr = record[0];
+        s->irr = record[1];
+        s->imr = record[2];
+        s->isr = record[3];
+        s->priority_add = record[4];
+        s->irq_base = record[5];
+        s->read_reg_select = record[6];
+        s->poll = record[7];
+        s->special_mask = record[8];
+        s->init_state = record[9];
+        s->auto_eoi = record[10];
+        s->rotate_on_auto_eoi = record[11];
+        s->special_fully_nested_mode = record[12];
+        s->init4 = record[13];
+        s->elcr = record[14];
+        s->elcr_mask = record[15];
+        pic_update_irq(s);
+    } else {
+        record[0] = s->last_irr;
+        record[1] = s->irr;
+        record[2] = s->imr;
+        record[3] = s->isr;
+        record[4] = s->priority_add;
+        record[5] = s->irq_base;
+        record[6] = s->read_reg_select;
+        record[7] = s->poll;
+        record[8] = s->special_mask;
+        record[9] = s->init_state;
+        record[10] = s->auto_eoi;
+        record[11] = s->rotate_on_auto_eoi;
+        record[12] = s->special_fully_nested_mode;
+        record[13] = s->init4;
+        record[14] = s->elcr;
+        record[15] = s->elcr_mask;
+    }
+    return true;
+}

