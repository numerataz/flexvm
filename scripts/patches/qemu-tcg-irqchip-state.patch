+FlexvmX86IrqchipRecord *qmp_x_flexvm_access_x86_irqchip(uint8_t chip_id,
+                                                     const char *record,
+                                                     Error **errp)
+{
+    static const char hex[] = "0123456789abcdef";
+    uint8_t bytes[FLEXVM_IOAPIC_IMAGE_SIZE] = { 0 };
+    size_t length = chip_id == 2 ? FLEXVM_IOAPIC_IMAGE_SIZE : FLEXVM_PIC_IMAGE_SIZE;
+    FlexvmX86IrqchipRecord *result;
+    bool ok;
+
+    if (!flexvm_stopped_cpu(0, errp)) {
+        return NULL;
+    }
+    if (chip_id > 2 || !object_dynamic_cast(OBJECT(qdev_get_machine()), TYPE_PC_MACHINE)) {
+        error_setg(errp, "FlexVM requires a valid x86 PC interrupt controller");
+        return NULL;
+    }
+    if (record) {
+        if (strlen(record) != 2 * length) {
+            error_setg(errp, "Invalid FlexVM interrupt controller image size");
+            return NULL;
+        }
+        for (size_t i = 0; i < length; i++) {
+            int hi = g_ascii_xdigit_value(record[2 * i]);
+            int lo = g_ascii_xdigit_value(record[2 * i + 1]);
+
+            if (hi < 0 || lo < 0) {
+                error_setg(errp, "Invalid hex in FlexVM interrupt controller image");
+                return NULL;
+            }
+            bytes[i] = (hi << 4) | lo;
+        }
+    }
+    if (chip_id == 2) {
+        ok = flexvm_ioapic_state(record != NULL, bytes);
+    } else {
+        ok = flexvm_pic_state(chip_id == 0, record != NULL, bytes);
+    }
+    if (!ok) {
+        error_setg(errp, "FlexVM interrupt controller state is unavailable");
+        return NULL;
+    }
+    result = g_new0(FlexvmX86IrqchipRecord, 1);
+    result->record = g_malloc(2 * length + 1);
+    for (size_t i = 0; i < length; i++) {
+        result->record[2 * i] = hex[bytes[i] >> 4];
+        result->record[2 * i + 1] = hex[bytes[i] & 15];
+    }
+    result->record[2 * length] = '\0';
+    return result;
+}
