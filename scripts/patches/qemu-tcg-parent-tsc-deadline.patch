+static bool apic_tsc_deadline_mode(uint32_t lvt)
+{
+    uint32_t modes = APIC_LVT_TIMER_PERIODIC | APIC_LVT_TIMER_TSCDEADLINE;
+
+    return (lvt & modes) == APIC_LVT_TIMER_TSCDEADLINE;
+}
+
+static bool apic_uses_flexvm_deadline(APICCommonState *s)
+{
+    return s && x86_flexvm_clock_enabled() &&
+           (s->apicbase & MSR_IA32_APICBASE_ENABLE) &&
+           apic_tsc_deadline_mode(s->lvt[APIC_LVT_TIMER]);
+}
+
+static void apic_flexvm_deadline_expired(void *opaque)
+{
+    APICCommonState *s = opaque;
+
+    assert(bql_locked());
+    qatomic_set(&s->cpu->env.tsc_deadline, 0);
+    if (apic_uses_flexvm_deadline(s)) {
+        apic_local_deliver(s, APIC_LVT_TIMER);
+    }
+}
+
+void apic_flexvm_reschedule_deadline(APICCommonState *s)
+{
+    assert(bql_locked());
+    if (s && s->flexvm_deadline_timer) {
+        CPUX86State *env = &s->cpu->env;
+        uint64_t deadline = qatomic_read(&env->tsc_deadline);
+        uint64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+        uint64_t tsc = now + env->tsc_offset;
+        uint64_t delta = deadline > tsc ? deadline - tsc : 0;
+
+        if (deadline) {
+            timer_mod_ns(s->flexvm_deadline_timer,
+                         now + MIN(delta, INT64_MAX - now));
+        } else {
+            timer_del(s->flexvm_deadline_timer);
+        }
+    }
+}
+
+uint64_t apic_flexvm_get_tsc_deadline(APICCommonState *s)
+{
+    assert(bql_locked());
+    return apic_uses_flexvm_deadline(s) ?
+           qatomic_read(&s->cpu->env.tsc_deadline) : 0;
+}
+
+void apic_flexvm_set_tsc_deadline(APICCommonState *s, uint64_t deadline)
+{
+    assert(bql_locked());
+    if (!apic_uses_flexvm_deadline(s)) {
+        return;
+    }
+    if (!s->flexvm_deadline_timer) {
+        s->flexvm_deadline_timer = timer_new_ns(QEMU_CLOCK_REALTIME,
+                                               apic_flexvm_deadline_expired, s);
+    }
+    qatomic_set(&s->cpu->env.tsc_deadline, deadline);
+    apic_flexvm_reschedule_deadline(s);
+}
+
+static void apic_flexvm_deadline_mode_changed(APICCommonState *s,
+                                             uint32_t old_lvt)
+{
+    if (x86_flexvm_clock_enabled() &&
+        apic_tsc_deadline_mode(old_lvt) != apic_tsc_deadline_mode(s->lvt[APIC_LVT_TIMER])) {
+        s->initial_count = 0;
+        qatomic_set(&s->cpu->env.tsc_deadline, 0);
+        if (s->flexvm_deadline_timer) {
+            timer_del(s->flexvm_deadline_timer);
+        }
+    }
+}
